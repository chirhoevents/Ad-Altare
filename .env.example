# ─── Clerk (sign-in) ── dashboard.clerk.com → API Keys ─────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ─── Neon PostgreSQL ── console.neon.tech → Connect ────────────────────────────
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# ─── Stripe (optional for priests; needed for direct gifts + /support) ─────────
# dashboard.stripe.com → Developers → API keys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Webhook 1 — "Your account" events → https://YOUR_DOMAIN/api/webhooks/stripe
#   events: payment_intent.succeeded, charge.refunded
STRIPE_WEBHOOK_SECRET=whsec_...
# Webhook 2 — "Connected accounts" events → https://YOUR_DOMAIN/api/webhooks/stripe/account
#   events: account.updated
STRIPE_WEBHOOK_SECRET_ACCOUNT=whsec_...
# Optional legacy endpoint /api/webhooks/stripe/connect (same handler as webhook 1)
STRIPE_WEBHOOK_SECRET_CONNECT=whsec_...

# ─── Resend (email) ── resend.com → API Keys; verify ad-altare.com under Domains ─
RESEND_API_KEY=re_...

# ─── Vercel Blob (photo uploads) ── Vercel → Storage → Blob → connect to project ─
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# ─── Cloudflare Turnstile (optional bot check on donation + support forms) ────
# dash.cloudflare.com → Turnstile → Add site. Leave unset to disable.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── App ── your live URL, no trailing slash ───────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
